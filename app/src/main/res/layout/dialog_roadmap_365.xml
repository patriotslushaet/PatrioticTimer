<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_kazakh"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Trophy"
            android:src="@drawable/ic_trophy_365" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Шкала 365 Дней Серии"
                android:textColor="#FFCC00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Каждые 10 дней виджет и ранг становятся лучше!"
                android:textColor="#33C5DB"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_roadmap"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#26FFCC00" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_tiers"
        android:layout_width="match_parent"
        android:layout_height="340dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dismiss_roadmap"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/kz_gold"
        android:text="Закрыть шкалу"
        android:textColor="#071A2C"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
