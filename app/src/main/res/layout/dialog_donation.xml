<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_kazakh"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🦅"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/tv_donation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Әзірлеушіні қолдау"
        android:textColor="#FEC50C"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_donation_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Поддержать разработчика патриотического будильника"
        android:textColor="#8DB4D6"
        android:textSize="12sp" />

    <!-- Grid of donation buttons: 100, 200, 500, 1000, 2000, 5000, 10000 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_donate_100"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_caspian"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="100 ₸"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_donate_200"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_caspian"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="200 ₸"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_donate_500"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_caspian"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="500 ₸"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_donate_1000"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_caspian"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="1 000 ₸"
            android:textColor="#33C5DB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_donate_2000"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_caspian"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="2 000 ₸"
            android:textColor="#33C5DB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_donate_5000"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_caspian"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="5 000 ₸"
            android:textColor="#FEC50C"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_donate_10000"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_caspian"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="👑 10 000 ₸ (Батыр Донат)"
        android:textColor="#FEC50C"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_close_donation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        android:text="Жабу (Закрыть)"
        android:textColor="#8DB4D6"
        android:textSize="12sp" />
</LinearLayout>
