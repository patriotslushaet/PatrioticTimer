<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_horizontal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- High-res authentic background from image_3.png -->
    <ImageView
        android:id="@+id/widget_horizontal_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Patriotic Timer Widget"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_horizontal" />

    <!-- Clickable Refresh overlay area on top right -->
    <TextView
        android:id="@+id/btn_widget_refresh"
        android:layout_width="90dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:background="#00000000" />

    <!-- Golden circle streak display area on left -->
    <RelativeLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_streak_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="15"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_streak_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="КҮН"
                android:textColor="#FEC50C"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
