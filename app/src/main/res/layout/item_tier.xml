<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tier_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#0D2845"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_tier_days_range"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_eligible"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="1-9 дн."
            android:textColor="#33C5DB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tier_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Бастау (Начало пути)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tier_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Первые шаги пробуждения патриота"
                android:textColor="#B2C9DF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_preview_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="Примерить"
            android:textColor="#FFCC00"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
