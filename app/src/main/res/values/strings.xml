    <string name="done_title">ВЫПОЛНЕНО!</string>
    <string name="done_kz">ЖАРАЙСЫҢ, ПАТРИОТ!</string>
    <string name="done_subtitle">Патриотический долг выполнен безупречно!</string>
    <string name="stat_stillness">Смирность стойки</string>
    <string name="stat_reaction">Время вставания в позу</string>
    <string name="stat_anthem_time">Время гимна</string>
